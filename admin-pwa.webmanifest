{
  "id": "/admin-pwa",
  "name": "Kingdom Fellowship Christian Church Admin",
  "short_name": "KFCC Admin",
  "description": "Administration app for Kingdom Fellowship Christian Church.",
  "start_url": "/admin.html",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#17202b",
  "background_color": "#f5f7f9",
  "icons": [
    {
      "src": "/admin-pwa-icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/admin-pwa-icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "prefer_related_applications": false
}
