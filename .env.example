# Required in production
NODE_ENV=production
PORT=3001
ADMIN_USERNAME=choose-a-username
ADMIN_PASSWORD=choose-a-long-random-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# Supabase persistence
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_STORAGE_BUCKET=church-media

# DATA_DIR is only used as a migration bridge if an old SQLite database exists.
DATA_DIR=./data
UPLOAD_DIR=./uploads
